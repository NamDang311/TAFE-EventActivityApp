<Page
    x:Class="myapp.Views.AddPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:myapp.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AddPage"
    d:DesignHeight="400"
    d:DesignWidth="600"
    WindowHeight="400"
    WindowWidth="600"
    mc:Ignorable="d">

    <Grid Background="#fefefe">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Margin="24"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel.Resources>
                <Style TargetType="{x:Type DockPanel}">
                    <Setter Property="Margin" Value="0,16,0,0" />
                </Style>
                <Style x:Key="FormLabelHoz" TargetType="{x:Type Label}">
                    <Setter Property="Width" Value="120" />

                </Style>
            </StackPanel.Resources>
            <DockPanel LastChildFill="True">
                <Label Style="{StaticResource FormLabelHoz}">
                    Date and Time
                </Label>
                <DatePicker HorizontalAlignment="Stretch" />
            </DockPanel>
            <DockPanel LastChildFill="True">
                <Label Style="{StaticResource FormLabelHoz}">
                    Title
                </Label>
                <TextBox />
            </DockPanel>
            <DockPanel LastChildFill="True">
                <Label Style="{StaticResource FormLabelHoz}">
                    Cost
                </Label>
                <TextBox />
            </DockPanel>
            <TabControl Margin="0,16,0,0">
                <TabItem Header="Fitness">
                    <DockPanel Margin="16" LastChildFill="True">
                        <Label DockPanel.Dock="Top" Margin="0,0,0,8">Location</Label>
                        <TextBox DockPanel.Dock="Top" Margin="0,0,0,16"/>
                        <Button>Save Fitness Activity</Button>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Entertainment" />

            </TabControl>

        </StackPanel>
    </Grid>

</Page>
