<Page
    x:Class="EventActivityApp.UI.Views.AddPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:EventActivityApp.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AddPage"
    d:DesignHeight="400"
    d:DesignWidth="600"
    WindowHeight="400"
    WindowWidth="800"
    mc:Ignorable="d">

    <Grid Background="#fefefe">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Margin="24"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel.Resources>
                <Style TargetType="{x:Type DockPanel}">
                    <Setter Property="Margin" Value="0,16,0,0" />
                </Style>

            </StackPanel.Resources>
            <DockPanel LastChildFill="True">
                <Label Style="{StaticResource FormLabelHoz}">
                    Date
                </Label>
                <DatePicker x:Name="DateTextBox" HorizontalAlignment="Stretch" />
            </DockPanel>
            <DockPanel LastChildFill="True">
                <Label Style="{StaticResource FormLabelHoz}">
                    Time
                </Label>
                <TextBox x:Name="TimeTextBox" />
            </DockPanel>
            <DockPanel LastChildFill="True">
                <Label Style="{StaticResource FormLabelHoz}">
                    Title
                </Label>
                <TextBox x:Name="TitleTextBox" />
            </DockPanel>
            <DockPanel LastChildFill="True">
                <Label Style="{StaticResource FormLabelHoz}">
                    Cost
                </Label>
                <TextBox x:Name="CostTextBox" />
            </DockPanel>

            <!--  Tab view  -->
            <TabControl Margin="0,16,0,0">
                <TabItem Header="Fitness">
                    <DockPanel Margin="16" LastChildFill="True">
                        <Label Margin="0,0,0,8" DockPanel.Dock="Top">Location</Label>
                        <TextBox
                            x:Name="FitnessLocationTextBox"
                            Margin="0,0,0,16"
                            DockPanel.Dock="Top" />
                        <Button Click="OnSaveFitnessClicked">Save Fitness Activity</Button>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Entertainment">
                    <DockPanel Margin="16" LastChildFill="True">
                        <Label Margin="0,0,0,8" DockPanel.Dock="Top">Min Participants</Label>
                        <TextBox
                            x:Name="MinParticipantTextBox"
                            Margin="0,0,0,16"
                            DockPanel.Dock="Top" />
                        <Button Click="OnSaveEntertainmentClicked">Save Entertainment Activity</Button>
                    </DockPanel>
                </TabItem>

            </TabControl>

        </StackPanel>
    </Grid>

</Page>
