<Page x:Class="EventActivityApp.UI.Views.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EventActivityApp.UI.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Home">

    <Grid Background="White">
        <StackPanel>
            <TextBlock Text="Welcome to the Event Activity App!" FontSize="24" FontWeight="Bold" Margin="16,40,16,16"/>
            <TextBlock Text="This application allows you to manage and track events and activities." FontSize="16" Margin="16"/>
            <StackPanel Orientation="Horizontal">
                <Button Click="OnSearchActivitiesClicked" Margin="16,0,16,0">Search Activities</Button>
                <Button Click="OnAddActivityClicked">Add Activity</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
