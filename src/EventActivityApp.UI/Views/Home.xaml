<Page
    x:Class="EventActivityApp.UI.Views.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:EventActivityApp.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Home"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Background="White">
        <StackPanel>
            <TextBlock
                Margin="16,40,16,8"
                FontSize="15"
                FontWeight="Bold"
                Text="Elevate Horizon Connect "
                Typography.Capitals="AllSmallCaps" />
            <TextBlock
                Margin="16,0,16,0"
                FontSize="24"
                FontWeight="Bold"
                Text="Find and plan your next activity" />
            <TextBlock
                Margin="16"
                FontSize="16"
                Text="Browse fitness and entertainment events, or add your own." />
            <StackPanel Orientation="Horizontal">
                <Button Margin="16,0,16,0" Click="OnSearchActivitiesClicked">Search Activities</Button>
                <Button Click="OnAddActivityClicked">Add Activity</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
