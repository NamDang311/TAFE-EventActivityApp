<Page
    x:Class="myapp.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:myapp.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SearchPage"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Margin="24"
            VerticalAlignment="Top"
            Orientation="Vertical">
            <StackPanel.Resources>
                <Style TargetType="{x:Type DockPanel}">
                    <Setter Property="Margin" Value="0,16,0,0" />
                </Style>
                <Style TargetType="{x:Type RadioButton}">
                    <Setter Property="Margin" Value="0,0,16,0" />
                </Style>
            </StackPanel.Resources>
            <DockPanel LastChildFill="True">
                <Label Style="{StaticResource FormLabelHoz}">
                    Search Date
                </Label>
                <DatePicker x:Name="SearchDatePicker" HorizontalAlignment="Stretch" />
            </DockPanel>
            <DockPanel LastChildFill="True">
                <Label Style="{StaticResource FormLabelHoz}">
                    Search Criteria
                </Label>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <RadioButton
                        x:Name="DateFilterRadioBefore"
                        GroupName="DateFilterRadio"
                        IsChecked="true">
                        Before
                    </RadioButton>
                    <RadioButton x:Name="DateFilterRadioOn" GroupName="DateFilterRadio">On</RadioButton>
                    <RadioButton x:Name="DateFilterRadioAfter" GroupName="DateFilterRadio">After</RadioButton>
                </StackPanel>
            </DockPanel>
            <DockPanel LastChildFill="True">
                <Button
                    Margin="0,0,0,16"
                    Click="SearchActivitiesClicked"
                    DockPanel.Dock="Top">
                    Search Activities
                </Button>
                <Button Click="OnDisplayAllClicked">Display All Activities</Button>
            </DockPanel>
            
            <!-- Result table view  -->
            <DataGrid
                x:Name="ActivityTable"
                Height="300"
                Margin="0,16,0,0"
                AlternatingRowBackground="#F2F2F2"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="2*"
                        Binding="{Binding DateStartTime}"
                        Header="DateTime" />
                    <DataGridTextColumn
                        Width="2*"
                        Binding="{Binding Title}"
                        Header="Title" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Cost}"
                        Header="Cost" />


                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Page>
