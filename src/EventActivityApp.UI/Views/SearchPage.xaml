<Page x:Class="myapp.Views.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:myapp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SearchPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="24" >
            <StackPanel.Resources>
                <Style TargetType="{x:Type DockPanel}">
                    <Setter Property="Margin" Value="0,16,0,0"/>
                </Style>
                <Style TargetType="{x:Type RadioButton}">
                    <Setter Property="Margin" Value="0,0,16,0"/>
                </Style>
            </StackPanel.Resources>
            <DockPanel LastChildFill="True">
                <Label Style="{StaticResource FormLabelHoz}">
                    Search Date
                </Label>
                <DatePicker HorizontalAlignment="Stretch"></DatePicker>
            </DockPanel >
            <DockPanel LastChildFill="True">
                <Label  Style="{StaticResource FormLabelHoz}">
                    Search Criteria
                </Label>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton GroupName="ready">Before</RadioButton>
                    <RadioButton GroupName="ready">On</RadioButton>
                    <RadioButton GroupName="ready">After</RadioButton>
                </StackPanel>
            </DockPanel >
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Top" Margin="0,0,0,16">Search Activities</Button>
                <Button>Display All Activities</Button>
            </DockPanel >
        </StackPanel>
    </Grid>
</Page>
